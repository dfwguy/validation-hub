[Unit]
Description=NVIS-OVA ValidationHub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=validationhub
Group=validationhub
WorkingDirectory=/opt/nvis-ova-validation-hub
Environment=VALIDATION_DATA_ROOT=/var/lib/validation-hub
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/validation-hub/environment
StateDirectory=validation-hub
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/nvis-ova-validation-hub/.venv/bin/python -m uvicorn backend.app:app --host 127.0.0.1 --port 8081 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/validation-hub

[Install]
WantedBy=multi-user.target
