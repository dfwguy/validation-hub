# Copy to .env for Compose. Keep the resulting file out of Git.
# Local Python defaults to ./var/validation-hub without environment variables.
# Compose overrides this root with its persistent named-volume mount.
VALIDATION_DATA_ROOT=./var/validation-hub
# Optional individual path overrides; blank values inherit the data root.
VALIDATION_DB=
VALIDATION_UPLOADS=
BEACON_DB=
BEACON_NCCL_DB=
CONFLUENCE_EVIDENCE_DB=
CONFLUENCE_EVIDENCE_DIR=
NCCL_DASHBOARD_SNAPSHOTS=

# Optional reference integrations. No source rows or credentials ship in Git.
BEACON_BASE_URL=https://llmb.nvidia.com/beacon-v2/runs
BEACON_API_URL=https://api.llmb.nvidia.com/v2/training/runs
GPUCOMMS_URL=https://gpucomms.nvidia.com/
NCCL_DASHBOARD_URL=https://nccl-perf-dashboard-354b5e.gitlab-master-pages.nvidia.com/
NCCL_DASHBOARD_GUIDANCE_URL=
ATLASSIAN_SITE=https://nvidia.atlassian.net/wiki
ATLASSIAN_CLOUD_ID=
ATLASSIAN_EMAIL=
# Set file paths only when mounting credentials; files must have mode 600.
# Do not put cookie/header/token values into this file or commit them.
# BEACON_HEADERS_FILE=/run/validation-secrets/beacon-headers.json
# BEACON_COOKIE_FILE=/run/validation-secrets/beacon-cookie.txt
# ATLASSIAN_TOKEN_FILE=/run/validation-secrets/atlassian-token
# VALIDATION_CHROMIUM=/path/to/installed/chromium
